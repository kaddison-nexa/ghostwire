# CockroachDB connection string (Cloud free tier or local `cockroach demo`)
DATABASE_URL=postgresql://user:password@host:26257/ghostwire?sslmode=verify-full

# AWS credentials for Bedrock (Titan embeddings + Claude generation).
# Leave unset to run in MOCK_LLM mode with deterministic fake embeddings/text.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# When true (or when AWS credentials are absent), bedrock.ts returns
# deterministic mock embeddings/text instead of calling Bedrock. Useful for
# local UI development without cloud credentials.
MOCK_LLM=true

PORT=4000

# Shared secret required on the deployed Function URL (checked in
# lambda-entry.ts only — local-server.ts ignores it, local dev is trusted).
# Leave unset locally; the deploy script generates and wires one in for the
# public endpoint. Must match VITE_API_KEY in frontend/.env when set.
API_KEY=
