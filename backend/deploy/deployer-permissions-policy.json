{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeployGhostwireLambda",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:GetFunction",
        "lambda:GetFunctionUrlConfig",
        "lambda:CreateFunctionUrlConfig",
        "lambda:AddPermission"
      ],
      "Resource": "arn:aws:lambda:eu-west-2:816772455264:function:ghostwire-api"
    },
    {
      "Sid": "CreateGhostwireLambdaRole",
      "Effect": "Allow",
      "Action": ["iam:CreateRole", "iam:GetRole", "iam:PutRolePolicy", "iam:AttachRolePolicy", "iam:PassRole"],
      "Resource": "arn:aws:iam::816772455264:role/ghostwire-lambda-role"
    }
  ]
}
